package: "android.security.keystore2"
container: "system"

flag {
  name: "wal_db_journalmode_v3"
  namespace: "hardware_backed_security"
  description: "This flag controls changing journalmode to wal"
  bug: "191777960"
  is_fixed_read_only: true
}

flag {
  name: "disable_legacy_keystore_put_v2"
  namespace: "hardware_backed_security"
  description: "Return an error when calling LegacyKeystore.put"
  bug: "307460850"
  is_fixed_read_only: true
}

flag {
  name: "disable_legacy_keystore_get"
  namespace: "hardware_backed_security"
  description: "Return an error when calling LegacyKeystore.get"
  bug: "307460850"
  is_fixed_read_only: true
}

flag {
  name: "import_previously_emulated_keys"
  namespace: "hardware_backed_security"
  description: "Include support for importing keys that were previously software-emulated into KeyMint"
  bug: "283077822"
  is_fixed_read_only: true
}

flag {
  name: "make_id_attestation_feature_public"
  namespace: "hardware_backed_security"
  description: "Makes the FEATURE_DEVICE_ID_ATTESTATION PackageManager feature public"
  bug: "432211581"
  is_fixed_read_only: true
  is_exported: true
}

flag {
  name: "limit_keys_per_uid"
  namespace: "hardware_backed_security"
  description: "Apply limits of #keys per-uid"
  bug: "395078130"
  is_fixed_read_only: true
  is_exported: true
}

flag {
  name: "mldsa_support"
  namespace: "hardware_backed_security"
  description: "Enable support for ML-DSA-65 and ML-DSA-87 in the AndroidKeyStore provider"
  bug: "395069350"
  is_fixed_read_only: true
  is_exported: true
}

flag {
  name: "atoms_v2"
  namespace: "hardware_backed_security"
  description: "Emit second generation of Keystore2 atoms"
  bug: "393058909"
  is_fixed_read_only: true
}

flag {
  name: "faster_rebind_cleanup"
  namespace: "hardware_backed_security"
  description: "Perform faster cleanup of orphaned blobs from rebinds"
  bug: "462372417"
  metadata {
    purpose: PURPOSE_BUGFIX
  }
  is_fixed_read_only: true
}

flag {
  name: "async_lock_state"
  namespace: "hardware_backed_security"
  description: "Handle lock state notifications asynchronously"
  bug: "421860260"
  metadata {
    purpose: PURPOSE_BUGFIX
  }
  is_fixed_read_only: true
}
